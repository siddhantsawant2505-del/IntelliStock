# Server
PORT=5000
NODE_ENV=development

# Database (local default shown)
MONGODB_URI=mongodb://127.0.0.1:27017/intellistock

# Auth - use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-me-with-a-32-character-random-string

# Comma-separated list of browser origins allowed to call the API
CLIENT_ORIGIN=http://localhost:3000

# How long the auth middleware may reuse a user lookup (milliseconds).
# Lower is stricter revocation, higher is fewer database round-trips. 0 disables.
AUTH_USER_CACHE_MS=5000

# Python ML service (Flask)
ML_SERVER_URL=http://localhost:8000
